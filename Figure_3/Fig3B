# immune-cell composition by timepoint (fraction of immune cells)
import csv, collections, numpy as np
import matplotlib; matplotlib.use("Agg")
import matplotlib.pyplot as plt

DIR = "/Users/jieli/Desktop/GSE211434"
RESP = {"Non-response":"Resistant","Response":"Sensitive"}
DAYS = ["0","14","180"]
CATS = ["Macrophages","CD4+ T cells","CD8+ T cells","NK cells","B cells","Plasma cells","DC"]
COL  = {"Macrophages":"#1f77b4","CD4+ T cells":"#ff7f0e","CD8+ T cells":"#e6c619",
        "NK cells":"#2ca02c","B cells":"#d62728","Plasma cells":"#9467bd","DC":"#8c564b"}

# per-patient counts: cnt[(patient,day)][cat], tot[(patient,day)]
cnt = collections.defaultdict(collections.Counter); tot = collections.Counter(); pinfo = {}
with open(f"{DIR}/GSE211434_cell_types.txt") as fh:
    h = fh.readline().rstrip("\n").split("\t"); ci = {x:i for i,x in enumerate(h)}
    for line in fh:
        p = line.rstrip("\n").split("\t")
        if p[ci["TreatmentArm"]] != "A": continue
        g = RESP.get(p[ci["ResponseYN"]]); d = p[ci["Day"]]; pt = p[ci["Patient"]]; st = p[ci["CellTypeSubtype"]]
        if g is None: continue
        cat = "Macrophages" if st in ("M1 macrophages","M2 macrophages") else st
        if cat in CATS:
            cnt[(pt,d)][cat] += 1; tot[(pt,d)] += 1; pinfo[pt] = g

# mean over patients (equal weight) of each patient's within-immune fraction
def frac(g, d, c):
    vals = [cnt[(pt,d)][c] / tot[(pt,d)] for pt in pinfo if pinfo[pt]==g and tot[(pt,d)]>0]
    return np.mean(vals) if vals else 0.0

npat = {"Sensitive":4, "Resistant":7}
fig, axes = plt.subplots(1, 2, figsize=(7.2, 4.6), sharey=True)
for ax, g in zip(axes, ["Sensitive","Resistant"]):
    for xi, d in enumerate(DAYS):
        bottom = 0.0
        for c in CATS:
            v = frac(g, d, c)
            ax.bar(xi, v, bottom=bottom, color=COL[c], width=0.72, edgecolor="white", lw=0.5)
            bottom += v
    ax.set_xticks(range(3)); ax.set_xticklabels([f"Day{d}" for d in DAYS])
    ax.set_ylim(0, 1.0); ax.set_xlabel(f"{g}\n(n={npat[g]})")
    for s in ("top","right"): ax.spines[s].set_visible(False)
axes[0].set_ylabel("Fraction of Immune cells")
handles = [plt.Rectangle((0,0),1,1,color=COL[c]) for c in CATS]
fig.legend(handles, CATS, loc="center left", bbox_to_anchor=(0.92, 0.5), frameon=False, fontsize=9)
plt.tight_layout(rect=[0,0,0.9,1])
plt.savefig(f"{DIR}/FELINE_immune_composition_byday_RECON.pdf", bbox_inches="tight"); plt.close()
print("DONE -> FELINE_immune_composition_byday_RECON.pdf")
